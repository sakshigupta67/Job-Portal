# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────────────────────────
# Secret used to sign recruiter JWT tokens — use a long random string in production
JWT_SECRET=replace_with_a_long_random_secret

# ─── Clerk (Webhook) ─────────────────────────────────────────────────────────
# Signing secret from the Clerk Dashboard → Webhooks section
# Used to verify incoming webhook payloads from Clerk
CLERK_WEBHOOK_SECRET=whsec_replace_with_your_clerk_webhook_secret

# ─── Cloudinary (file uploads) ───────────────────────────────────────────────
# Leave all three blank to fall back to local /uploads folder (development only)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed client origins
# Example for production: CLIENT_URL=https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# ─── Server ──────────────────────────────────────────────────────────────────
# Port the Express server listens on (defaults to 3000 if not set)
PORT=3000
