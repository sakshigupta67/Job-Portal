# ─── Clerk (Job Seeker Auth) ─────────────────────────────────────────────────
# Publishable key from the Clerk Dashboard → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key

# ─── Backend API URL ─────────────────────────────────────────────────────────
# Base URL of the Express server — no trailing slash
# Development: http://localhost:3000
# Production example: https://your-api.vercel.app
VITE_BACKEND_URL=http://localhost:3000
